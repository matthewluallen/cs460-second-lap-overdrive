{
  "name": "Slipstream classroom server",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {"label": "Slipstream HTTPS", "onAutoForward": "notify", "protocol": "http"}
  },
  "postCreateCommand": "npm ci --ignore-scripts",
  "remoteUser": "node"
}
