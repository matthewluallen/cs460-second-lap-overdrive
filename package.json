{
  "name": "cs460-second-lap-overdrive",
  "version": "0.1.0",
  "private": true,
  "description": "CS460 scenario platform: stationary bench, mock support API and simulator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node platform/server.mjs",
    "test": "node --test bench/*.test.mjs platform/*.test.mjs instructor-drive/*.test.mjs slipstream/*.test.mjs",
    "test:platform": "node --test platform/*.test.mjs",
    "dependency-lab": "node platform/dependency-lab.mjs",
    "audit": "npm audit --audit-level=low",
    "slipstream": "node platform/server.mjs --slipstream"
  },
  "dependencies": {
    "express": "5.3.0",
    "qrcode-generator": "2.0.4",
    "ws": "8.22.2"
  }
}
